<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Fruity Prime is a regular self-contained .NET publish, not Native AOT.
         The CLR JIT needs MAP_JIT under the hardened runtime. Without this the
         kernel can terminate a correctly signed process before managed Main
         gets a chance to print anything. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
